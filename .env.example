# URL base de la API. Vacía = mismo origen:
# - en desarrollo, el proxy de Vite reenvía /api a http://localhost:8080 (vite.config.ts);
# - en Vercel, el rewrite de vercel.json reenvía /api al backend en Render.
# Déjala vacía en ambos casos: con otro dominio, las cookies SameSite=Strict no viajarían.
# Copia este archivo a .env.local (ignorado por git) solo si necesitas cambiarla.
VITE_API_URL=
